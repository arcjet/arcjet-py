# Get your Arcjet key from https://app.arcjet.com
ARCJET_KEY=replace-me
ARCJET_ENV=development
# Anthropic API key used by Claude Managed Agents (hosted REST+SSE)
ANTHROPIC_API_KEY=replace-me
# Optional. Defaults to claude-sonnet-4-5.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional. Reuse an existing agent / environment instead of creating them.
# ANTHROPIC_AGENT_ID=agent_...
# ANTHROPIC_ENVIRONMENT_ID=env_...
# Optional. Stop the session with user.interrupt after this many
# agent.custom_tool_use rounds. Defaults to 8.
# ANTHROPIC_MAX_TOOL_ROUNDS=8
